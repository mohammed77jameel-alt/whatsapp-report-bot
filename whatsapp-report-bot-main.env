/**
 * whatsapp-report-bot-main/bot.js
 * Telegram Remote Control & Dispatch Interface (Hardcoded Direct Fix)
 */

const { Telegraf } = require('telegraf');
const reportService = require('./services/report-service');
const emailService = require('./services/email-service');

// التوكن المباشر بدون أي اعتماد على ملفات خارجية
const BOT_TOKEN = '8225164127:AAH2TsWPPSJOVTtpvdQnX4fnrB5Vpcol14U';

const bot = new Telegraf(BOT_TOKEN);

// رسالة الترحيب عند البدء أو إرسال /start
bot.start((ctx) => {
    ctx.reply(
        "🚀 أهلاً بك يا بطل في نظام إدارة عمليات الإبلاغ الآلي.\n\n" +
        "الأوامر المتاحة:\n" +
        "📌 لإرسال تقرير بلاغ رقم:\n" +
        "/report <رقم_الهاتف>\n\n" +
        "مثال:\n" +
        "/report 123456789"
    );
});

// أمر استقبال البلاغات عبر التيليجرام
bot.command('report', async (ctx) => {
    const textParts = ctx.message.text.split(' ');
    const targetPhone = textParts[1];

    if (!targetPhone) {
        return ctx.reply("❌ يرجى كتابة الرقم الصحيح بعد الأمر.\nمثال: `/report 123456789`", { parse_mode: 'Markdown' });
    }

    await ctx.reply(`⏳ جاري معالجة وإرسال البلاغ للرقم: +${targetPhone}...`);

    try {
        const payload = await reportService.compile(targetPhone, 'report', 'false_positive');
        await emailService.sendReport(targetPhone, payload.body);

        await ctx.reply(`✅ [تم بنجاح] تم إرسال تقرير البلاغ للرقم +${targetPhone} عبر خادم البريد وتحويله لجهات الدعم.`);
    } catch (error) {
        await ctx.reply(`🚨 حدث خطأ أثناء الإرسال:\n${error.message}`);
    }
});

// تشغيل البوت
bot.launch().then(() => {
    console.log("🤖 Telegram Control Bot is active and listening for commands...");
});

// إيقاف آمن للبوت عند الخروج
process.once('SIGINT', () => bot.stop('SIGINT'));
process.once('SIGTERM', () => bot.stop('SIGTERM'));